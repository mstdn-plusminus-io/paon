RAILS_ENV=development
NODE_ENV=development

LOCAL_DOMAIN=localhost:3000
WEB_DOMAIN=localhost:3000
# PAON_SCHEME=http
# PAON_VERSION=6.0.2
# Rails-compatible version/source metadata used by instance APIs and NodeInfo.
# PAON_VERSION_PRERELEASE=
# PAON_VERSION_METADATA=
# MASTODON_VERSION_PRERELEASE=
# MASTODON_VERSION_METADATA=
# GITHUB_REPOSITORY=mstdn-plusminus-io/paon
# SOURCE_BASE_URL=https://github.com/mstdn-plusminus-io/paon
# SOURCE_TAG=
# DEFAULT_LOCALE remains the fallback for unauthenticated users. Mastodon 4.4
# prefers the browser's Accept-Language unless this compatibility override is true.
# FORCE_DEFAULT_LOCALE=false
# Build-time revision exported as OpenTelemetry vcs.repository.ref.revision.
# SOURCE_COMMIT=
# Optional. When omitted, Paon mirrors Rails:
# production uses ws(s)://WEB_DOMAIN, development uses ws://localhost:4000,
# and REMOTE_DEV=true uses ws(s)://LOCAL_DOMAIN host.
# STREAMING_API_BASE_URL=ws://localhost:3000
# Optional. Prefer this for Paon-only deployments; otherwise BIND/PORT are used.
# PAON_GO_ADDR=127.0.0.1:3000
# Optional. Matches Rails/Puma SOCKET unix bind when PAON_GO_ADDR is unset.
# SOCKET=/tmp/paon.sock
# Optional. Matches Rails/Puma proxy_protocol: :v1 listener mode.
# PROXY_PROTO_V1=true
# Optional. Matches Rails/Puma persistent_timeout keep-alive idle timeout.
# PERSISTENT_TIMEOUT=20
BIND=127.0.0.1
PORT=3000
# Existing built Mastodon UI assets are served from this directory.
# PAON_PUBLIC_DIR=public

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_USER=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_NAMESPACE= was removed in Mastodon 4.4 and any configured value causes startup to fail.
# With every Paon process stopped, migrate an old namespace explicitly with:
# paon-admin redis namespace-cutover --prefix mastodon --dry-run
# paon-admin redis namespace-cutover --prefix mastodon --confirm
# Sentinel master discovery. MASTER and a non-empty SENTINELS list are paired;
# sentinel credentials inherit the corresponding Redis USER/PASSWORD unless set.
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINELS=sentinel-1.example:26379,sentinel-2.example
# REDIS_SENTINEL_PORT=26379
# REDIS_SENTINEL_USERNAME=
# REDIS_SENTINEL_PASSWORD=
# Rails role-specific Redis URLs. CACHE_REDIS_URL is used for Rails.cache
# invalidation; SIDEKIQ_REDIS_URL is used by Paon's asynq worker/client.
# Both URLs are validated at startup.
# CACHE_REDIS_URL=
# SIDEKIQ_REDIS_URL=
# CACHE_REDIS_HOST=cache.example
# CACHE_REDIS_PORT=6379
# CACHE_REDIS_DB=0
# CACHE_REDIS_USER=
# CACHE_REDIS_PASSWORD=
# CACHE_REDIS_SENTINEL_MASTER=cache-master
# CACHE_REDIS_SENTINELS=sentinel-1.example:26379,sentinel-2.example
# CACHE_REDIS_SENTINEL_PORT=26379
# CACHE_REDIS_SENTINEL_USERNAME=
# CACHE_REDIS_SENTINEL_PASSWORD=
# SIDEKIQ_REDIS_HOST=worker.example
# SIDEKIQ_REDIS_PORT=6379
# SIDEKIQ_REDIS_DB=0
# SIDEKIQ_REDIS_USER=
# SIDEKIQ_REDIS_PASSWORD=
# SIDEKIQ_REDIS_SENTINEL_MASTER=worker-master
# SIDEKIQ_REDIS_SENTINELS=sentinel-1.example:26379,sentinel-2.example
# SIDEKIQ_REDIS_SENTINEL_PORT=26379
# SIDEKIQ_REDIS_SENTINEL_USERNAME=
# SIDEKIQ_REDIS_SENTINEL_PASSWORD=
# Asynq worker concurrency. ASYNQ_CONCURRENCY takes precedence over the legacy
# SIDEKIQ_CONCURRENCY setting.
# ASYNQ_CONCURRENCY=5
# SIDEKIQ_CONCURRENCY=5
# Comma-separated logical queues handled by this worker process. Supported
# values: default, push, ingress, mailers, pull, removal, remote_removal, fasp.
# Unset means all queues. Run removal and remote_removal in a dedicated worker
# to isolate bulk status deletion; remote_removal has the lowest queue weight.
# ASYNQ_QUEUES=push,pull
# Comma-separated experimental Mastodon features. FASP endpoints, admin pages,
# provider requests, and workers remain unavailable unless explicitly enabled.
# EXPERIMENTAL_FEATURES=fasp
# Recursive reply fetching remains opt-in and is scheduled only for signed-in
# context requests. Limits must be positive integers.
FETCH_REPLIES_ENABLED=false
FETCH_REPLIES_COOLDOWN_MINUTES=15
FETCH_REPLIES_INITIAL_WAIT_MINUTES=5
FETCH_REPLIES_MAX_GLOBAL=1000
FETCH_REPLIES_MAX_SINGLE=500
FETCH_REPLIES_MAX_PAGES=500
# Worker/all roles create tmp/<basename> only after Redis, queues, and the
# scheduler are ready, and remove it during graceful shutdown.
# MASTODON_SIDEKIQ_READY_FILENAME=worker-ready

DB_HOST=127.0.0.1
DB_USER=postgres
DB_NAME=postgres
DB_PASS=password
DB_PORT=5432
# DB_POOL=5
# PAON_DB_MAX_IDLE_CONNS=5
# PostgreSQL lock acquisition fails fast instead of waiting for an Asynq task
# deadline. Accepts seconds or a Go duration; set 0 to disable. An explicit
# lock_timeout query parameter in DATABASE_URL takes precedence.
# PAON_DB_LOCK_TIMEOUT=5s
# DB_SSLMODE=prefer
# PREPARED_STATEMENTS=true
# Replica-specific options fall back to their primary/default values.
# REPLICA_PREPARED_STATEMENTS=true
# REPLICA_DB_TASKS=true
# Paon can either use DATABASE_URL or the Rails-compatible DB_* values above.
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/postgres?sslmode=disable
# Existing Mastodon 4.2 databases advance through separately committed
# expand, backfill, validate, and contract phases.
# Unset defaults to the additive expand phase. Contract also requires the
# explicit acknowledgement after every 4.2 process has stopped.
# PAON_MIGRATION_PHASE=expand
# PAON_MIGRATION_ACKNOWLEDGE_CONTRACT=false

# Meilisearch (Paon replaces Elasticsearch with Meilisearch)
MEILI_ENABLED=false
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=aSampleMasterKey
# MEILI_PREFIX=myinstance
# MEILI_LIBRARY_ONLY=false

DISABLE_SIGNUP_BY_API=false

# OmniAuth / OpenID Connect compatibility. When OIDC_ENABLED=true, Paon
# --check-config validates the same required values Rails needs to initialize.
# OIDC_ENABLED=false
# OIDC_DISPLAY_NAME=
# OIDC_DISCOVERY=true
# OIDC_SCOPE=openid,email
# OIDC_RESPONSE_TYPE=code
# OIDC_RESPONSE_MODE=query
# OIDC_DISPLAY=page
# OIDC_PROMPT=
# OIDC_SEND_NONCE=true
# OIDC_SEND_SCOPE_TO_TOKEN_ENDPOINT=true
# OIDC_USE_PKCE=false
# OIDC_SECURITY_ASSUME_EMAIL_IS_VERIFIED=false
# OIDC_CLIENT_AUTH_METHOD=basic
# OIDC_UID_FIELD=sub
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://localhost:3000/auth/auth/openid_connect/callback
# OIDC_HTTP_SCHEME=https
# OIDC_HOST=
# OIDC_PORT=
# OIDC_AUTH_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_USER_INFO_ENDPOINT=
# OIDC_JWKS_URI=
# OIDC_END_SESSION_ENDPOINT=
# OIDC_IDP_LOGOUT_REDIRECT_URI=
# Optional. When OMNIAUTH_ONLY=true, /auth/edit links users to the IdP-side
# account settings page instead of rendering local password/e-mail fields.
# SSO_ACCOUNT_SETTINGS=https://sso.example.test/account

# CAS OmniAuth compatibility. When CAS_ENABLED=true, configure either CAS_URL
# (base URL) or explicit CAS_LOGIN_URL and CAS_VALIDATE_URL.
# CAS_ENABLED=false
# CAS_DISPLAY_NAME=
# CAS_URL=https://cas.example.test/cas
# CAS_LOGIN_URL=
# CAS_VALIDATE_URL=
# CAS_CALLBACK_URL=https://localhost:3000/auth/auth/cas/callback
# CAS_LOGOUT_URL=
# CAS_CA_PATH=
# CAS_DISABLE_SSL_VERIFICATION=false
# CAS_UID_KEY=user
# CAS_EMAIL_KEY=email
# CAS_NAME_KEY=name
# CAS_NICKNAME_KEY=nickname
# CAS_FIRST_NAME_KEY=firstname
# CAS_LAST_NAME_KEY=lastname
# CAS_LOCATION_KEY=location
# CAS_IMAGE_KEY=image
# CAS_PHONE_KEY=phone
# CAS_SECURITY_ASSUME_EMAIL_IS_VERIFIED=false

# SAML OmniAuth compatibility. Unsigned, signed, and encrypted SAMLResponse
# assertions are supported by Paon when the matching SAML_* keys are set.
# SAML_ENABLED=false
# SAML_DISPLAY_NAME=
# SAML_ACS_URL=https://localhost:3000/auth/auth/saml/callback
# SAML_ISSUER=https://localhost:3000
# SAML_IDP_SSO_TARGET_URL=
# SAML_IDP_SSO_TARGET_PARAMS=
# SAML_IDP_CERT=
# SAML_IDP_CERT_FINGERPRINT=
# SAML_IDP_CERT_FINGERPRINT_VALIDATOR=
# SAML_CERT=
# SAML_PRIVATE_KEY=
# SAML_NAME_IDENTIFIER_FORMAT=
# SAML_SECURITY_WANT_ASSERTION_SIGNED=false
# SAML_SECURITY_WANT_ASSERTION_ENCRYPTED=false
# SAML_SECURITY_ASSUME_EMAIL_IS_VERIFIED=false
# SAML_ATTRIBUTES_STATEMENTS_UID=uid
# SAML_ATTRIBUTES_STATEMENTS_EMAIL=email
# SAML_ATTRIBUTES_STATEMENTS_FULL_NAME=full_name
# SAML_ATTRIBUTES_STATEMENTS_FIRST_NAME=first_name
# SAML_ATTRIBUTES_STATEMENTS_LAST_NAME=last_name
# SAML_ATTRIBUTES_STATEMENTS_VERIFIED=verified
# SAML_ATTRIBUTES_STATEMENTS_VERIFIED_EMAIL=verified_email
# SAML_UID_ATTRIBUTE=uid
# SAML_ALLOWED_CLOCK_DRIFT=0

# Devise LDAP/PAM compatibility. LDAP_ENABLED=true uses the same bind/search
# shape as Rails. PAM_ENABLED=true uses PAM_DEFAULT_SERVICE through
# PAM_AUTH_COMMAND (defaults to pamtester) and creates confirmed local users
# with the same username/e-mail fallback shape as Rails' PAM setup.
# LDAP_ENABLED=false
# LDAP_HOST=localhost
# LDAP_PORT=389
# LDAP_METHOD=simple_tls
# LDAP_BASE=
# LDAP_BIND_DN=
# LDAP_PASSWORD=
# LDAP_UID=cn
# LDAP_MAIL=mail
# LDAP_TLS_NO_VERIFY=false
# LDAP_SEARCH_FILTER=(|(%{uid}=%{email})(%{mail}=%{email}))
# LDAP_UID_CONVERSION_ENABLED=false
# LDAP_UID_CONVERSION_SEARCH=".,- "
# LDAP_UID_CONVERSION_REPLACE=_
# PAM_ENABLED=false
# PAM_EMAIL_DOMAIN=example.com
# PAM_DEFAULT_SERVICE=rpam
# PAM_CONTROLLED_SERVICE=
# PAM_AUTH_COMMAND=pamtester

# Federation safety modes
# AUTHORIZED_FETCH=true
# LIMITED_FEDERATION_MODE=true
# WHITELIST_MODE=true

# Notification spam filtering for interactions.must_be_human
# SPAM_DETECTION_METHOD=simple
# SPAMMER_FOLLOWER_THRESHOLD=5
# SPAMMER_CREATION_THRESHOLD=6
# SPAMMER_MENTION_THRESHOLD=1
# OPENAI_ACCESS_TOKEN=
# OPENAI_SPAM_FILTER_MODEL=gpt-4.1-mini
# SPAM_FILTER_OPENAI_SYSTEM_MESSAGE=

CLOUDFLARE_TURNSTILE_ENABLED=false
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Rails hCaptcha confirmation flow. Effective only when admin registration
# settings have captcha_enabled=true.
# HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET_KEY=

STATUS_LENGTH_LIMIT=65535

# Media tools and image processor compatibility. The processor is selected
# when the Go binary is built, not at runtime. MASTODON_USE_LIBVIPS therefore
# emits a compatibility warning instead of silently changing behavior. Docker
# builds use --build-arg PAON_IMAGE_PROCESSOR=auto|native (default: auto).
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe
# MASTODON_USE_LIBVIPS=true

# Mastodon 4.4 runtime no longer uses OTP_SECRET. Set it only while running a
# 4.3 upgrade that still needs to decrypt legacy attr_encrypted TOTP rows.
# OTP_SECRET=
# Generate and permanently retain independent random values for these keys.
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=change-me-to-an-independent-random-value-at-least-32-bytes
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=change-me-to-an-independent-random-value-at-least-32-bytes
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=change-me-to-an-independent-random-value-at-least-32-bytes
SECRET_KEY_BASE=change-me-to-an-independent-random-value-at-least-32-bytes

# Rails production ActionMailer-compatible SMTP settings.
# SMTP_SERVER=smtp.example.test
# SMTP_PORT=587
# SMTP_LOGIN=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=notifications@localhost
# SMTP_DOMAIN=
# SMTP_AUTH_METHOD=plain
# SMTP_REPLY_TO=
# SMTP_RETURN_PATH=
# SMTP_ENABLE_STARTTLS=auto
# SMTP_ENABLE_STARTTLS_AUTO=true
# SMTP_TLS=false
# SMTP_SSL=false
# SMTP_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# SMTP_OPENSSL_VERIFY_MODE=
# SMTP_DELIVERY_METHOD=smtp
# Optional dedicated transport used only for announcement and terms-of-service
# distribution. Setting any BULK_SMTP_* key requires BULK_SMTP_SERVER; login
# and password must be configured together. Otherwise normal SMTP is used.
# BULK_SMTP_SERVER=bulk-smtp.example.test
# BULK_SMTP_PORT=587
# BULK_SMTP_LOGIN=
# BULK_SMTP_PASSWORD=
# BULK_SMTP_DOMAIN=
# BULK_SMTP_AUTH_METHOD=plain
# BULK_SMTP_ENABLE_STARTTLS=auto
# BULK_SMTP_ENABLE_STARTTLS_AUTO=true
# BULK_SMTP_TLS=false
# BULK_SMTP_SSL=false
# BULK_SMTP_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# BULK_SMTP_OPENSSL_VERIFY_MODE=

MAX_MEDIA_ATTACHMENTS=8
# Rails FollowLimitValidator-compatible follow caps for local accounts.
# MAX_FOLLOWS_THRESHOLD=7500
# MAX_FOLLOWS_RATIO=1.1
# IMAGE_LIMIT_MEGABYTES=1
# VIDEO_LIMIT_MEGABYTES=1
# DISABLE_REMOTE_MEDIA_CACHE=true

# ALLOWED_PRIVATE_ADDRESSES=172.16.34.1,172.16.33.23

# S3_ENABLED=true
# S3_BUCKET=media.dev.mstdn.local.plusminus.io
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# S3_REGION=ap-northeast-1
# S3_PROTOCOL=https
# S3_HOSTNAME=media.dev.mstdn.local.plusminus.io
# S3_ENDPOINT=https://s3.ap-northeast-1.wasabisys.com/
# S3_ALIAS_HOST=media.dev.mstdn.local.plusminus.io
# Additional media origins allowed by the Content-Security-Policy. Values must
# be absolute http(s) origins without credentials, paths, queries, or fragments.
# EXTRA_MEDIA_HOSTS=https://media-archive.example.test,https://media2.example.test
# S3_PERMISSION=public-read
# S3_STORAGE_CLASS=STANDARD
# S3_MULTIPART_THRESHOLD=15728640
# S3_SIGNATURE_VERSION=v4
# S3_OPEN_TIMEOUT=5
# S3_READ_TIMEOUT=5
# S3_FORCE_SINGLE_REQUEST=false
# S3_ENABLE_CHECKSUM_MODE=false
# S3_KEY_PREFIX=production
# S3_RETRY_LIMIT=0
# S3_BATCH_DELETE_LIMIT=1000
# Total attempts, including the initial batch-delete request.
# S3_BATCH_DELETE_RETRY=3
# SWIFT_ENABLED=true
# SWIFT_USERNAME=
# SWIFT_PROJECT_ID=
# SWIFT_TENANT=
# SWIFT_PASSWORD=
# SWIFT_AUTH_URL=https://swift.example/v3
# SWIFT_DOMAIN_NAME=default
# SWIFT_REGION=
# SWIFT_CACHE_TTL=60
# SWIFT_CONTAINER=container
# SWIFT_OBJECT_URL=https://swift.example/v1/AUTH_project/container
# SWIFT_TEMP_URL_KEY=
# AZURE_ALIAS_HOST=media.example
# PAPERCLIP_ROOT_PATH=public/system
# PAPERCLIP_ROOT_URL=/system
# CACHE_BUSTER_ENABLED=false
# CACHE_BUSTER_HTTP_METHOD=GET
# CACHE_BUSTER_SECRET_HEADER=Secret-Header
# CACHE_BUSTER_SECRET=True

# OpenTelemetry is disabled unless a base or signal-specific OTLP endpoint is
# configured. The base endpoint enables both traces and metrics. Paon uses the
# official OTLP HTTP/protobuf exporters; endpoint URLs must not contain tokens
# or query parameters. Put collector credentials in *_HEADERS instead and do
# not print those values in diagnostics.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20replace-me
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
# Mastodon 4.3 service naming defaults to mastodon/<role>.
# OTEL_SERVICE_NAME_PREFIX=mastodon
# OTEL_SERVICE_NAME_SEPARATOR=/
# Mastodon leaves the SDK sampler at its parent-based always-on default.
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=
# Optional ratio sampling example: parentbased_traceidratio with ARG=0.10.
# OTEL_PROPAGATORS=tracecontext,baggage
# Mastodon 4.4 Prometheus exporter flags map onto the existing OTLP metrics
# pipeline. ENABLED requires an OTLP metrics endpoint. Paon does not start the
# separate LOCAL/HOST/PORT exporter listener.
# MASTODON_PROMETHEUS_EXPORTER_ENABLED=false
# MASTODON_PROMETHEUS_EXPORTER_WEB_DETAILED_METRICS=false
# MASTODON_PROMETHEUS_EXPORTER_SIDEKIQ_DETAILED_METRICS=false

# StatsD is a legacy Paon compatibility extension. It is active only when no
# OTLP endpoint is configured, preventing duplicate web/worker measurements.
# STATSD_ADDR=127.0.0.1:8125
# STATSD_NAMESPACE=Mastodon.development
# STATSD_SIDEKIQ=false

# Legacy Paon quote migration only. Mastodon 4.4 runtime quote state is stored
# exclusively in PostgreSQL. Configure these values only while running the
# read-only source side of `paon-admin quotes cutover --dry-run|--confirm`;
# normal web and worker processes never read or write DynamoDB quotes.
# DYNAMODB_ENABLED=true
# DYNAMODB_NAMESPACE=paon
# DYNAMODB_REGION=ap-northeast-1
# DYNAMODB_AWS_ACCESS_KEY_ID=
# DYNAMODB_AWS_SECRET_ACCESS_KEY=
# DYNAMODB_AWS_SESSION_TOKEN=
# DYNAMODB_ENDPOINT=
